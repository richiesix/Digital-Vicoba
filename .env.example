# Laravel Backend (copy to backend/.env)
APP_NAME="Digital Vikoba"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=digital_vicoba
DB_USERNAME=root
DB_PASSWORD=

# Docker overrides
MYSQL_HOST=mysql
MYSQL_DATABASE=digital_vicoba
MYSQL_USER=vicoba
MYSQL_PASSWORD=vicobapass
MYSQL_ROOT_PASSWORD=rootpass

# Redis
REDIS_URL=redis://redis:6379/0

# JWT (also set APP_KEY via php artisan key:generate)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption
AES_ENCRYPTION_KEY=change-me-32-byte-aes-key-here!!

# SMS / USSD (Africa's Talking)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your-api-key
AFRICASTALKING_SHORTCODE=14999
USSD_SESSION_TIMEOUT_SECONDS=180

# Mobile Money (sandbox URLs)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
MIXX_API_KEY=
HALOPESA_API_KEY=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Admin
ADMIN_DEFAULT_EMAIL=admin@digitalvikoba.co.tz
